{
  "name": "lanternlight",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "iwsdk dev restart --open --foreground",
    "dev:runtime": "vite",
    "dev:down": "iwsdk dev down",
    "dev:status": "iwsdk dev status",
    "reference:status": "iwsdk reference status",
    "reference:warmup": "iwsdk reference warmup",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e:flow": "node e2e/flow.mjs",
    "e2e:controllers": "node e2e/controllers.mjs",
    "e2e:rooms": "node e2e/rooms.mjs",
    "e2e": "node e2e/run-all.mjs",
    "poses:build": "esbuild tools/iwer-poses/build.ts --bundle --platform=node --format=esm --outfile=tools/iwer-poses/.out/build.mjs --log-level=warning && node tools/iwer-poses/.out/build.mjs > e2e/fixtures/iwer-poses.json",
    "dev:emu": "vite --port 8081 --strictPort"
  },
  "dependencies": {
    "@iwsdk/core": "1.0.1",
    "@pmndrs/uikit": "^1.0.74",
    "@pmndrs/uikit-horizon": "^1.0.74",
    "@pmndrs/uikit-lucide": "^1.0.74",
    "three": "npm:super-three@0.181.0"
  },
  "devDependencies": {
    "@iwsdk/cli": "1.0.1",
    "@iwsdk/reference": "1.0.1",
    "@iwsdk/vite-plugin-dev": "1.0.1",
    "@types/three": "^0.181.0",
    "gl-matrix": "^3.4.4",
    "typescript": "^5.5.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "sharp": "0.35.4",
    "three": "npm:super-three@0.181.0"
  },
  "engines": {
    "node": ">=20.19.0 <21.0.0-0 || >=22.12.0 <23.0.0-0 || >=24.0.0"
  },
  "description": "Lanternlight - a hand-shadow theatre for your room (mixed reality WebXR for Meta Quest, built with IWSDK).",
  "license": "MIT"
}
